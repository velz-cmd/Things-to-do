{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "framework": "nextjs",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/discover-final-production": true,
      "codex/discover-economic-actions": true,
      "fix/discover-marketplace-completion": true,
      "release/**": false,
      "cursor/**": false,
      "codex/**": false,
      "*": false
    }
  },
  "github": {
    "autoJobCancelation": true,
    "silent": true
  },
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 6 * * *"
    }
  ]
}
